# ==============================================================================
# BookLeaf Author Royalty Dashboard & Notification System - Environment Template
# ==============================================================================

# --- Bubble.io Configuration ---
# Your Bubble development app domain (without trailing slash)
BUBBLE_APP_URL=https://bookleaf-royalty-portal-93860.bubbleapps.io/version-test

# Bubble API Token (Settings > API > Generate API Token)
BUBBLE_API_TOKEN=your_bubble_api_token_here

# --- Webhook Authentication Secret ---
# Shared secret passed from Bubble in the 'X-BookLeaf-Secret' header
BOOKLEAF_WEBHOOK_SECRET=your_generated_secure_webhook_secret_here

# --- n8n Workflow Automation ---
# Cloud instance
N8N_PORT=443
N8N_HOST=bookleaf-assign2.app.n8n.cloud
N8N_PROTOCOL=https
# Public Webhook Domain
N8N_PUBLIC_URL=https://bookleaf-assign2.app.n8n.cloud

# --- AI Provider API Keys (Choose at least one) ---
# Option 1: Google Gemini API (Recommended free tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq Cloud API (Fast Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
